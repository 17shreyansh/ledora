# Copy to .env for local development. Never commit .env files.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ledora?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
SESSION_COOKIE_NAME=ledora_sid
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
TRUST_PROXY=1
LOG_LEVEL=info
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Ledora <no-reply@ledora.com>
AUDIT_RETENTION_DAYS=730
MAX_ORGS_PER_USER=25
RATE_LIMIT_ENABLED=true
