# Base URL of the Ledora API (including /api/v1). Defaults to http://localhost:4000/api/v1.
VITE_API_URL=http://localhost:4000/api/v1

# URL of the Ledora browser SDK that customers load on their websites. Used in the install snippet.
# Defaults to http://localhost:4000/sdk/v1/widget.js.
VITE_SDK_URL=http://localhost:4000/sdk/v1/widget.js

# Optional. Public API base the SDK should send events to, when it is not served from the same origin as
# the SDK script. When set, the install snippet gains data-ledora-api="<value>". No default: leave it empty
# to omit the attribute.
VITE_PUBLIC_API_URL=
