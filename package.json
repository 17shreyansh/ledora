{
  "name": "ledora",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Ledora — website analytics, engagement, lead generation and monitoring platform",
  "workspaces": [
    "packages/shared",
    "server",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build -w @ledora/shared && npm run build -w @ledora/server && npm run build -w @ledora/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev -w @ledora/server",
    "dev:worker": "npm run dev:worker -w @ledora/server",
    "dev:web": "npm run dev -w @ledora/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
